# ============================================================
# 7. PRACTICE - REAL-LIFE ARRAY OPERATIONS
# ============================================================

# Add bonus marks
marks = np.array([65, 72, 80, 88, 91])
bonus = 5
updated_marks = marks + bonus
print(marks)
print(updated_marks)

# GST calculation
prices = np.array([200, 350, 540, 500])
prices_with_gst = prices * 1.18
print(prices_with_gst)

# Discount calculation
prices = np.array([100, 250, 400, 550, 800])
discount = prices * 0.10
price_after_discount = prices - discount
print(price_after_discount)

# Celsius to Fahrenheit
celsius = np.array([0, 10, 20, 30, 40])
fahrenheit = 9 / 5 * celsius + 32
print(fahrenheit)

# Expected increase in sales
sales = np.array([125000, 148000, 135000, 172000])
expected_sales = 1.15 * sales
print(expected_sales)

# Tuple to NumPy array
marks_tuple = (78, 85, 92, 67, 88)
marks_array = np.array(marks_tuple)
print(marks_array + 3)


# ============================================================
# 8. STATISTICAL FUNCTIONS
# ============================================================

a = np.array([10, 20, 30, 40, 50])

print(np.max(a))
print(np.min(a))
print(np.sum(a))
print(np.mean(a))

temperature = np.array([
    28.5, 31.2, 29.8, 35.6, 38.1,
    40.2, 27.9, 30.5, 42.3, 39.8
])

print(np.mean(temperature))
print(np.median(temperature))
print(np.max(temperature))
print(np.min(temperature))
print(np.std(temperature))
print(np.var(temperature))


# ============================================================
# 9. BOOLEAN FILTERING
# ============================================================

marks = np.array([45, 34, 6, 56, 35, 7, 45, 7, 8])

print(marks[marks > 9])
print(marks > 40)

selected_marks = marks[marks < 50]
print(selected_marks)
print(selected_marks + 5)


# ============================================================
# 10. np.where()
# ============================================================

marks = np.array([12, 25, 8, 40, 55, 3, 70])

print(np.where(marks > 10))

prices = np.array([5000, 1200, 800, 2500, 1500])
discounted_prices = np.where(prices > 1000, prices * 0.9, prices)
print(discounted_prices)

sales = np.array([950000, 650000, 300000, 800000, 450000])

performance = np.where(
    sales >= 800000,
    "top performer",
    np.where(sales >= 500000, "good performer", "needs improvement")
)
print(performance)


# ============================================================
# 11. COMPOUND CONDITIONS
# ============================================================

salary = np.array([60000, 75000, 55000, 30000])
credit_score = np.array([720, 750, 680, 710])

result = np.where(
    (salary >= 50000) & (credit_score >= 720),
    "approve",
    "reject"
)
print(result)

orders = np.array([500, 1200, 700, 800, 1500])
premium_customer = np.array([False, False, True, False, True])

delivery = np.where(
    (orders >= 1000) | (premium_customer == True),
    "free delivery",
    "not a free delivery"
)
print(delivery)


